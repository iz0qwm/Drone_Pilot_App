<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/webviewLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#191970">

    <!-- Barra titolo con icona e testo -->
    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#191970"
        android:padding="12dp">

        <ImageView
            android:id="@+id/newsIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_dflight"
            android:contentDescription="Logo D-flight"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/newsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D-flight"
            android:textSize="20sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Tasto "Chiudi" in basso -->
    <Button
        android:id="@+id/closeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chiudi"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:background="#B22222"
        android:padding="12dp"
        android:textSize="16sp"
        android:layout_alignParentBottom="true" />

    <!-- WebView tra titolo e pulsante -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/titleBar"
        android:layout_above="@id/closeButton" />

    <!-- ProgressBar centrata -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</RelativeLayout>
