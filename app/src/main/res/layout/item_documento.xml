<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/iconDocumentPreview"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_file_placeholder"
        android:layout_gravity="center_vertical" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/textDocumentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titolo documento"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000" />

        <TextView
            android:id="@+id/textDocumentType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo: Assicurazione"
            android:textSize="14sp"
            android:textColor="#555" />

        <TextView
            android:id="@+id/textDocumentExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scadenza: 31/12/2025"
            android:textSize="14sp"
            android:textColor="#888" />
    </LinearLayout>

</LinearLayout>
