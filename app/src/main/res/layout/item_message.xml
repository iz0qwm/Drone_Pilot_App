<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="start"> <!-- Aggiunto per la gestione dell'allineamento -->

    <!-- Messaggio dell'altro utente -->
    <TextView
        android:id="@+id/otherMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/darker_gray"
        android:textColor="@android:color/white"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_gravity="start" /> <!-- Aggiunto per l'allineamento a sinistra -->

    <!-- Messaggio del proprio utente -->
    <TextView
        android:id="@+id/myMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/holo_blue_light"
        android:textColor="@android:color/black"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_gravity="end" /> <!-- Aggiunto per l'allineamento a destra -->

</LinearLayout>
