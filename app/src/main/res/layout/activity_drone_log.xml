<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:id="@+id/droneLogLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- SPAZIO VUOTO PER ABBASSARE DI POCO !-->
        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <TextView
            android:id="@+id/logTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📁 Importa Log di Volo DJI"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:textColor="#191970" />

        <TextView
            android:id="@+id/logDescriptionTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Importa l'ultimo file di log del tuo drone DJI registrato dalla DJI FLY. La traiettoria di volo verrà mostrata sulla mappa."
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textColor="#333333" />

        <Button
            android:id="@+id/importLogButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Importa"
            android:textAllCaps="false"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:backgroundTint="#191970"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center"
            android:background="@drawable/rounded_button_blue" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mapCard"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:theme="@style/Theme.MaterialComponents.Light"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            app:strokeWidth="4dp"
            app:strokeColor="@color/black">

        <!-- Contenitore per mappa + touch view -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.gms.maps.MapView
                android:id="@+id/flightMap"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginBottom="16dp" />

            <!-- QUI sopra, la touch interceptor view -->
            <com.kwos.dronepilotapp.TransparentTouchView
                android:id="@+id/touchInterceptor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"/>
        </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/summaryModel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚁 Drone: -" android:textSize="16sp" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/summaryDuration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏱️ Durata: -" android:textSize="16sp" />
        <TextView android:id="@+id/summaryBattery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔋 Batteria: -" android:textSize="16sp" />
        <TextView android:id="@+id/summaryDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📏 Distanza: -" android:textSize="16sp" />
        <TextView android:id="@+id/summaryMaxSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚀 Velocità Max: -" android:textSize="16sp" />
        <TextView android:id="@+id/summaryMaxAltitude" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗻 Altezza Max: -" android:textSize="16sp" />

        <Button
            android:id="@+id/sendToMapButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Rendi visibile il volo sulla mappa"
            android:textAllCaps="false"
            android:layout_marginTop="24dp"
            android:background="@drawable/rounded_button_blue"
            android:textColor="@android:color/white" />


        <Button
            android:id="@+id/close_dronelog_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ Chiudi"
            android:layout_marginTop="16dp"
            android:textColor="@color/button_text_color"
            android:background="@drawable/rounded_button_red" />

    </LinearLayout>
</ScrollView>
