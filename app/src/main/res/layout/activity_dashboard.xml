<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#e7e1d3"
        android:padding="16dp">

        <!-- Contenitore per il titolo e l'icona del menu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/welcomeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Benvenuto!"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:padding="10dp"/>

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:padding="8dp"/>
        </RelativeLayout>

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout" />

        <EditText
            android:id="@+id/droneField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome Drone" />

        <!-- Contenitore orizzontale per i due bottoni -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/startFlightButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Inizio volo"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/stopFlightButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Fine volo"/>

            <Switch
                android:id="@+id/chatToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disponibile per chat"/>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="325dp"
            android:theme="@style/Theme.MaterialComponents.Light"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            app:strokeWidth="4dp"
            app:strokeColor="@color/black">

            <FrameLayout
                android:id="@+id/mapContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.google.android.material.card.MaterialCardView>


        <LinearLayout
            android:id="@+id/new_message_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="visible"
            android:layout_marginTop="5dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/new_message_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_mail"
                android:contentDescription="Nessun messaggio" />

            <TextView
                android:id="@+id/new_message_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="...uhm nessun messaggio"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weather_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:gravity="center">

            <!-- Pulsante per aprire le previsioni meteo -->
            <Button
                android:id="@+id/weather_forecast_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Previsioni Meteo e GPS"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- TextView per il messaggio di piloti nelle vicinanze -->
        <TextView
            android:id="@+id/pilotNearAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nessun pilota nelle vicinanze"
            android:textSize="16sp"
            android:textColor="@android:color/holo_green_dark"
            android:gravity="center"
            android:padding="5dp"
            android:background="#e7e1d3"/>

        <TextView
            android:id="@+id/lowerLimitTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caricamento..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="5dp"/>


    </LinearLayout>
</ScrollView>