<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#f4f4f4"
            android:padding="16dp">

            <!-- Contenitore per il titolo e l'icona del menu -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/welcomeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Benvenuto!"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_centerHorizontal="true"
                    android:padding="10dp"/>

                <ImageButton
                    android:id="@+id/menuButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_menu"
                    android:contentDescription="Menu"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"/>
            </RelativeLayout>

            <!-- EditText per il nome del drone -->
            <EditText
                android:id="@+id/droneField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_input"
                android:padding="10dp"
                android:textColor="#000"
                android:textColorHint="#ccc"
                android:layout_marginBottom="8dp"
                android:hint="Nome Drone" />

            <!-- Contenitore orizzontale per i due bottoni -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/startFlightButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Inizio volo"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color"
                    android:background="@drawable/rounded_button_blue"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/stopFlightButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Fine volo"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color"
                    android:background="@drawable/rounded_button_blue"/>

                <Switch
                    android:id="@+id/chatToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disponibile per chat"
                    android:thumbTint="@color/blue_button"
                    android:trackTint="@color/blue_button" />

            </LinearLayout>

            <!-- Card con la mappa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="325dp"
                android:theme="@style/Theme.MaterialComponents.Light"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp"
                app:strokeWidth="4dp"
                app:strokeColor="@color/black">

                <FrameLayout
                    android:id="@+id/mapContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.card.MaterialCardView>

            <!-- Icona nuovi messaggi -->
            <LinearLayout
                android:id="@+id/new_message_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="visible"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/new_message_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mail"
                    android:contentDescription="Nessun messaggio" />

                <TextView
                    android:id="@+id/new_message_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="...uhm nessun messaggio"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp" />
            </LinearLayout>

            <!-- Pulsanti per previsioni meteo e Spot di volo -->
            <LinearLayout
                android:id="@+id/weather_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:padding="8dp">

                <Button
                    android:id="@+id/weather_forecast_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meteo e GPS"
                    android:textAllCaps="false"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/button_text_color"
                    android:background="@drawable/rounded_button_blue"
                    android:layout_marginEnd="8dp"/>

                <!-- Pulsante Spot di Volo -->
                <Button
                    android:id="@+id/takeoff_spots_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spot di Volo"
                    android:textAllCaps="false"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/button_text_color"
                    android:background="@drawable/rounded_button_green"/>
            </LinearLayout>

            <!-- TextView per i messaggi di piloti nelle vicinanze -->
            <TextView
                android:id="@+id/pilotNearAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nessun pilota nelle vicinanze"
                android:textSize="16sp"
                android:textColor="@android:color/holo_green_dark"
                android:gravity="center"
                android:padding="5dp"
                android:background="#f4f4f4"/>

            <TextView
                android:id="@+id/lowerLimitTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Caricamento..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"/>

            <!-- Pulsante Logout -->
            <Button
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="@color/button_text_color"
                android:background="@drawable/rounded_button_blue"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
