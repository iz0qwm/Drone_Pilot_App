<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/welcomeTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Benvenuto!"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:padding="10dp"/>

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout" />

    <EditText
        android:id="@+id/droneField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nome Drone" />

    <!-- Contenitore orizzontale per i due bottoni -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/startFlightButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Inizio volo"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/stopFlightButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Fine volo"/>

        <Switch
            android:id="@+id/chatToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponibile per chat"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="325dp"
        android:visibility="visible" />

</LinearLayout>
