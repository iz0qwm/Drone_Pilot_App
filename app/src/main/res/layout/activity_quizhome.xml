<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- SPAZIO VUOTO PER ABBASSARE DI POCO !-->
            <View
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <!-- Intro -->
            <TextView
                android:id="@+id/quizIntroText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📘 Scopri quanto conosci il mondo dei droni.\nRispondi ai quiz per imparare a volare in modo consapevole, sicuro e secondo le regole."
                android:textSize="16sp"
                android:padding="16dp"
                android:layout_marginBottom="12dp" />

            <!-- Lista quiz -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/quizListRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Messaggio di caricamento -->
            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Caricamento quiz..."
                android:textSize="16sp"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:visibility="visible" />


            <!-- Tasto Chiudi -->
            <Button
                android:id="@+id/close_quiz_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❌ Chiudi"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/rounded_button_blue" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>