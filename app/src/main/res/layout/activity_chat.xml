<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#e7e1d3"
        android:padding="10dp"
        android:clipToPadding="false">

        <!-- Aggiungi questa TextView in cima per il nome del pilota -->
        <TextView
            android:id="@+id/chattingWithText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stai chattando con: [Nome Pilota]"
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:padding="8dp"
            android:gravity="center"/>

        <!-- RecyclerView per i messaggi -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Area di input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Scrivi un messaggio" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invia"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>