<resources>

    <style name="AppButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:backgroundTint">#2196F3</item> <!-- Blu webapp -->
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:elevation">4dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:textAllCaps">false</item> <!-- Disattiva il MAIUSCOLO -->
        <item name="android:paddingStart">16dp</item> <!-- Padding interno personalizzato -->
    </style>

    <style name="AppButton.Green" parent="AppButton">
    <item name="android:backgroundTint">#4CAF50</item> <!-- Verde per "Spot di volo" -->
    </style>

    <style name="AppEditText" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
    <item name="android:background">@drawable/edit_text_background</item>
    <item name="android:padding">10dp</item>
    <item name="android:textColor">#000000</item>
    <item name="android:textColorHint">#888888</item>
    </style>

    <style name="AppTextView" parent="TextAppearance.AppCompat">
    <item name="android:textColor">#333333</item> <!-- Colore grigio scuro per il testo -->
    <item name="android:textSize">16sp</item> <!-- Dimensione testo uniforme -->
    <item name="android:fontFamily">sans-serif-medium</item> <!-- Font sans-serif per eleganza -->
    <item name="android:lineSpacingExtra">4dp</item> <!-- Maggiore distanza tra le righe -->
    </style>

    <style name="AppTextViewBold" parent="TextAppearance.AppCompat">
    <item name="android:textColor">#333333</item> <!-- Colore grigio scuro per il testo -->
    <item name="android:textSize">18sp</item> <!-- Testo più grande per titoli -->
    <item name="android:fontFamily">sans-serif-medium</item> <!-- Font sans-serif per eleganza -->
    <item name="android:textStyle">bold</item> <!-- Stile grassetto per titoli -->
    </style>

    <style name="AppPopupMenu" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:popupBackground">@drawable/rounded_popup_bg</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>


</resources>